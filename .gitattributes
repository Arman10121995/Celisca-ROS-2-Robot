# Track large mesh files with Git LFS
*.stl filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.USD filter=lfs diff=lfs merge=lfs -text
# Track ORB vocabulary
ORBvoc.txt filter=lfs diff=lfs merge=lfs -text
# Track other large binary files
*.bin filter=lfs diff=lfs merge=lfs -text
*.pcd filter=lfs diff=lfs merge=lfs -text
# Occupancy maps stay in Git so CI and source-only checkouts can validate them
# even when the separate large-mesh LFS quota is unavailable.
*.pgm -filter -diff -merge -text

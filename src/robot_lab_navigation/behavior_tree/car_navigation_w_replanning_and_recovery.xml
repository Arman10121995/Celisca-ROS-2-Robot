<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <!-- Three attempts after the first (2026-10-16): with a 0.1 m goal
             circle a car can stall 0.1-0.2 m out, where settling would need
             a multi-point manoeuvre (MuJoCo anti-Ackermann, seed 2, aborted
             0.15 m short after one retry). Backing up gives the next
             attempt room for a fresh curvature-constrained approach. -->
        <RecoveryNode number_of_retries="3" name="NavigateRecovery">
            <PipelineSequence name="NavigateWithReplanning">
                <RateController hz="1.0">
                    <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                </RateController>
                <FollowPath path="{path}" controller_id="FollowPath"/>
            </PipelineSequence>
            <!-- A car cannot execute the default Spin recovery. Back up to
                 make room for a new curvature-constrained approach.
                 2026-11-15: after a "collision ahead" stop beside a cone or
                 a parked car the planner reports the start in lethal space
                 and the straight back-up can be blocked too ("Collision
                 Ahead - Exiting DriveOnHeading"), which failed the whole goal
                 7.7 cm from the obstacle. Then drive a short way forward on
                 the current heading instead; both moves are collision-checked. -->
            <Sequence>
                <Fallback>
                    <BackUp backup_dist="0.30" backup_speed="0.15"/>
                    <DriveOnHeading dist_to_travel="0.20" speed="0.15" time_allowance="5"/>
                </Fallback>
                <Wait wait_duration="1.0"/>
            </Sequence>
        </RecoveryNode>
    </BehaviorTree>
</root>

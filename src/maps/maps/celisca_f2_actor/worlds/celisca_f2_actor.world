<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="celisca_floor_2">
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1.0</direction>
    </light>

    <!-- https://gazebosim.org/docs/harmonic/actors/ -->
    <actor name="actor_walking">
        <skin>
            <filename>package://bumperbot_description/meshes/MaleVisitorWalkDownloaded.dae</filename>
            <scale>1.0</scale>
        </skin>
        <animation name="walk">
            <filename>package://bumperbot_description/meshes/MaleVisitorWalkDownloaded.dae</filename>
            <interpolate_x>true</interpolate_x>
        </animation>
        <script>
            <loop>true</loop>
            <delay_start>1.000000</delay_start>
            <auto_start>true</auto_start>
          <trajectory id="0" type="walk" tension="0.6">
            <waypoint>
                <time>0</time>
                <pose>0 0 1 0 0 0</pose>
            </waypoint>
            <waypoint>
                <time>3</time>
                <pose>2 0 1 0 0 0</pose>
            </waypoint>
            <waypoint>
                <time>4</time>
                <pose>2 0 1 0 0 -1.57</pose>
            </waypoint>
            <waypoint>
                <time>9</time>
                <pose>2 -4 1 0 0 -1.57</pose>
            </waypoint>
            <waypoint>
                <time>10</time>
                <pose>2 -4 1 0 0 1.57</pose>
            </waypoint>
            <waypoint>
                <time>15</time>
                <pose>2 0 1 0 0 1.57</pose>
            </waypoint>
            <waypoint>
                <time>16</time>
                <pose>2 0 1 0 0 3.14</pose>
            </waypoint>
            <waypoint>
                <time>20</time>
                <pose>0 0 1 0 0 3.14</pose>
            </waypoint>
            <waypoint>
                <time>21</time>
                <pose>0 0 1 0 0 0</pose>
            </waypoint>
        </trajectory>
    </script>
    </actor>

    <model name="physics_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>100 100 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>100 100 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="celisca_floor_2">
      <static>true</static>
      <link name="link">

        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://maps/maps/celisca_f2_actor/meshes/celisca_floor_2.stl</uri>
              <scale>3 3 3</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.5 1.0</ambient>
            <diffuse>0.1 0.1 0.4 1.0</diffuse>
            <specular>0.05 0.05 0.1 1.0</specular>
          </material>
        </visual>

        <!-- REQUIRED FOR NAV TO WORK -->
        <visual name="visual_backfaces">
          <geometry>
            <mesh>
              <uri>package://maps/maps/celisca_f2_actor/meshes/celisca_floor_2.stl</uri>
              <scale>3 3 3</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.5 1.0</ambient>
            <diffuse>0.1 0.1 0.4 1.0</diffuse>
            <specular>0.05 0.05 0.1 1.0</specular>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://maps/maps/celisca_f2_actor/meshes/celisca_floor_2.stl</uri>
              <scale>3 3 3</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>

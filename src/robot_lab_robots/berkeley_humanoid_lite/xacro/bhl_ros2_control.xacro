<?xml version="1.0"?>
<!--
  P3.4: ros2_control + gz-sim wiring for the Berkeley Humanoid Lite
  simulated, commandable profile.

  Additive to the vendored static upstream URDF (berkeley_humanoid_lite.urdf),
  included alongside it by bhl_sim.xacro. Declares the 22 effort-commandable
  leg/arm joints with position command + position/velocity state interfaces,
  the ros2_control/gz-sim system plugins, and the trunk IMU sensor that backs
  the registry /imu contract.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="bhl_joint" params="name">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="bhl_ros2_control" params="is_ignition:=true">

    <ros2_control name="BHLSystem" type="system">

      <xacro:if value="$(arg is_ignition)">
        <hardware>
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="$(arg is_ignition)">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:unless>

      <!-- 12 leg joints -->
      <xacro:bhl_joint name="leg_left_hip_roll_joint"/>
      <xacro:bhl_joint name="leg_left_hip_yaw_joint"/>
      <xacro:bhl_joint name="leg_left_hip_pitch_joint"/>
      <xacro:bhl_joint name="leg_left_knee_pitch_joint"/>
      <xacro:bhl_joint name="leg_left_ankle_pitch_joint"/>
      <xacro:bhl_joint name="leg_left_ankle_roll_joint"/>
      <xacro:bhl_joint name="leg_right_hip_roll_joint"/>
      <xacro:bhl_joint name="leg_right_hip_yaw_joint"/>
      <xacro:bhl_joint name="leg_right_hip_pitch_joint"/>
      <xacro:bhl_joint name="leg_right_knee_pitch_joint"/>
      <xacro:bhl_joint name="leg_right_ankle_pitch_joint"/>
      <xacro:bhl_joint name="leg_right_ankle_roll_joint"/>

      <!-- 10 arm joints -->
      <xacro:bhl_joint name="arm_left_shoulder_pitch_joint"/>
      <xacro:bhl_joint name="arm_left_shoulder_roll_joint"/>
      <xacro:bhl_joint name="arm_left_shoulder_yaw_joint"/>
      <xacro:bhl_joint name="arm_left_elbow_roll_joint"/>
      <xacro:bhl_joint name="arm_left_elbow_pitch_joint"/>
      <xacro:bhl_joint name="arm_right_shoulder_pitch_joint"/>
      <xacro:bhl_joint name="arm_right_shoulder_roll_joint"/>
      <xacro:bhl_joint name="arm_right_shoulder_yaw_joint"/>
      <xacro:bhl_joint name="arm_right_elbow_roll_joint"/>
      <xacro:bhl_joint name="arm_right_elbow_pitch_joint"/>

    </ros2_control>

    <!-- gz-sim system plugins and controller parameters -->
    <gazebo>
      <xacro:if value="$(arg is_ignition)">
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <parameters>$(find robot_lab_robots)/berkeley_humanoid_lite/config/bhl_controllers.yaml</parameters>
        </plugin>
        <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
        <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
          <render_engine>ogre2</render_engine>
        </plugin>
      </xacro:if>
      <xacro:unless value="$(arg is_ignition)">
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find robot_lab_robots)/berkeley_humanoid_lite/config/bhl_controllers.yaml</parameters>
        </plugin>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
          <render_engine>ogre2</render_engine>
        </plugin>
      </xacro:unless>
    </gazebo>

    <!-- IMU sensor on the trunk backing the /imu registry contract -->
    <gazebo reference="imu_2">
      <sensor name="bhl_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>imu</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>

<?xml version="1.0"?>
<!-- Mecanum (roller) base; see holonomic_wheels_macro.xacro. -->
<robot name="mecanum_car" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="is_ignition" default="true"/>
  <xacro:arg name="is_sim" default="true"/>
  <xacro:include filename="$(find robot_lab_robots)/description_common/urdf/oakd_camera.xacro"/>
  <xacro:include filename="$(find robot_lab_robots)/holonomic_wheels/urdf/holonomic_wheels_macro.xacro"/>
  <xacro:mecanum_car robot_name="mecanum_car"/>
</robot>

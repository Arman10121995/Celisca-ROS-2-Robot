<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="lab_amphibious">
  <xacro:arg name="model_name" default="lab_amphibious" />
  <xacro:arg name="is_ignition" default="true" />
  <xacro:include filename="$(find robot_lab_robots)/description_common/urdf/oakd_camera.xacro" />
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -.12" rpy="0 0 0" />
      <mass value="50" />
      <inertia ixx="4.1" iyy="8.1" izz="10.2" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision name="sealed_hull_collision">
      <geometry>
        <box size="1.3 .82 .34" />
      </geometry>
    </collision>
    <visual name="sealed_hull_visual">
      <geometry>
        <box size="1.3 .82 .34" />
      </geometry>
      <material name="hull_orange">
        <color rgba=".95 .4 .05 1" />
      </material>
    </visual>
  </link>
  <xacro:oakd name="oakd" parent_link="base_link" model="pro" mesh_visual="false" rate="5">
    <origin xyz=".66 0 .3" rpy="0 0 0" />
  </xacro:oakd>
  <gazebo reference="base_link">
    <sensor name="marine_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/marine/imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
    </sensor>
  </gazebo>
  <link name="front_left_carrier">
    <inertial>
      <mass value=".1" />
      <inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="front_left_suspension_joint" type="prismatic">
    <parent link="base_link" />
    <child link="front_left_carrier" />
    <origin xyz="0.43 0.49 -.12" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-.04" upper=".04" effort="600" velocity=".3" />
  </joint>
  <link name="front_left_wheel">
    <inertial>
      <mass value="1" />
      <inertia ixx=".0126" iyy=".0242" izz=".0126" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision name="front_left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
    </collision>
    <visual name="front_left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
      <material name="tire">
        <color rgba=".08 .08 .1 1" />
      </material>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_carrier" />
    <child link="front_left_wheel" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="8" velocity="3" />
    <dynamics damping=".02" friction=".01" />
  </joint>
  <gazebo reference="front_left_wheel">
    <mu1>.9</mu1>
    <mu2>.9</mu2>
  </gazebo>
  <link name="rear_left_carrier">
    <inertial>
      <mass value=".1" />
      <inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="rear_left_suspension_joint" type="prismatic">
    <parent link="base_link" />
    <child link="rear_left_carrier" />
    <origin xyz="-0.43 0.49 -.12" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-.04" upper=".04" effort="600" velocity=".3" />
  </joint>
  <link name="rear_left_wheel">
    <inertial>
      <mass value="1" />
      <inertia ixx=".0126" iyy=".0242" izz=".0126" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision name="rear_left_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
    </collision>
    <visual name="rear_left_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
      <material name="tire">
        <color rgba=".08 .08 .1 1" />
      </material>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="rear_left_carrier" />
    <child link="rear_left_wheel" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="8" velocity="3" />
    <dynamics damping=".02" friction=".01" />
  </joint>
  <gazebo reference="rear_left_wheel">
    <mu1>.9</mu1>
    <mu2>.9</mu2>
  </gazebo>
  <link name="front_right_carrier">
    <inertial>
      <mass value=".1" />
      <inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="front_right_suspension_joint" type="prismatic">
    <parent link="base_link" />
    <child link="front_right_carrier" />
    <origin xyz="0.43 -0.49 -.12" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-.04" upper=".04" effort="600" velocity=".3" />
  </joint>
  <link name="front_right_wheel">
    <inertial>
      <mass value="1" />
      <inertia ixx=".0126" iyy=".0242" izz=".0126" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision name="front_right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
    </collision>
    <visual name="front_right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
      <material name="tire">
        <color rgba=".08 .08 .1 1" />
      </material>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_carrier" />
    <child link="front_right_wheel" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="8" velocity="3" />
    <dynamics damping=".02" friction=".01" />
  </joint>
  <gazebo reference="front_right_wheel">
    <mu1>.9</mu1>
    <mu2>.9</mu2>
  </gazebo>
  <link name="rear_right_carrier">
    <inertial>
      <mass value=".1" />
      <inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="rear_right_suspension_joint" type="prismatic">
    <parent link="base_link" />
    <child link="rear_right_carrier" />
    <origin xyz="-0.43 -0.49 -.12" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-.04" upper=".04" effort="600" velocity=".3" />
  </joint>
  <link name="rear_right_wheel">
    <inertial>
      <mass value="1" />
      <inertia ixx=".0126" iyy=".0242" izz=".0126" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <collision name="rear_right_wheel_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
    </collision>
    <visual name="rear_right_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius=".22" length=".075" />
      </geometry>
      <material name="tire">
        <color rgba=".08 .08 .1 1" />
      </material>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="rear_right_carrier" />
    <child link="rear_right_wheel" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit effort="8" velocity="3" />
    <dynamics damping=".02" friction=".01" />
  </joint>
  <gazebo reference="rear_right_wheel">
    <mu1>.9</mu1>
    <mu2>.9</mu2>
  </gazebo>
  <link name="port_propeller_link">
    <inertial>
      <mass value=".05" />
      <inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius=".065" length=".02" />
      </geometry>
    </visual>
  </link>
  <joint name="port_propeller_joint" type="continuous">
    <parent link="base_link" />
    <child link="port_propeller_link" />
    <origin xyz="-.64 0.38 -.15" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit effort="5" velocity="400" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>port_propeller_joint</joint_name>
      <thrust_coefficient>.0044</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>.13</propeller_diameter>
      <min_thrust_cmd>-35</min_thrust_cmd>
      <max_thrust_cmd>35</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <link name="starboard_propeller_link">
    <inertial>
      <mass value=".05" />
      <inertia ixx=".0001" iyy=".0001" izz=".0001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius=".065" length=".02" />
      </geometry>
    </visual>
  </link>
  <joint name="starboard_propeller_joint" type="continuous">
    <parent link="base_link" />
    <child link="starboard_propeller_link" />
    <origin xyz="-.64 -0.38 -.15" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit effort="5" velocity="400" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>starboard_propeller_joint</joint_name>
      <thrust_coefficient>.0044</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>.13</propeller_diameter>
      <min_thrust_cmd>-35</min_thrust_cmd>
      <max_thrust_cmd>35</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/marine/odometry</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/marine/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
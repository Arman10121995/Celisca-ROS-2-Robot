<?xml version="1.0"?>
<!--
  P3.3: complete simulated, commandable Go2 description.

  Combines the vendored upstream Unitree description (robot.xacro) with the
  ros2_control/gz-sim wiring (go2_ros2_control.xacro). This is the xacro that
  a bringup launch would process and spawn; the registry assets.urdf entry
  points here.
-->
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="is_ignition" default="true"/>

  <xacro:include filename="$(find robot_lab_robots)/unitree/go2_description/xacro/robot.xacro"/>
  <xacro:include filename="$(find robot_lab_robots)/unitree/go2_description/xacro/go2_ros2_control.xacro"/>

  <xacro:go2_ros2_control is_ignition="$(arg is_ignition)"/>

  <!-- 2D LiDAR for localization (2026-10-12), at the front of the trunk where
       the real Go2 carries its head LiDAR, clear of the trunk and legs.  Gazebo renders
       it; the PyBullet/MuJoCo/Isaac bridges cast their scan from this link. -->
  <joint name="laser_joint" type="fixed">
    <parent link="trunk"/>
    <child link="laser_link"/>
    <origin xyz="0.20 0 0.12" rpy="0 0 0"/>
  </joint>
  <link name="laser_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <topic>scan</topic>
      <update_rate>5</update_rate>
      <gz_frame_id>laser_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>

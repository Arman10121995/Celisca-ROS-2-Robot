      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <link name="thruster_5_link">
    <inertial>
      <mass value=".01" />
      <inertia ixx=".000004" iyy=".000004" izz=".000004" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".04" length=".008" />
      </geometry>
      <material name="dark_grey" />
    </visual>
  </link>
  <joint name="thruster_5_joint" type="continuous">
    <parent link="base_link" />
    <child link="thruster_5_link" />
    <origin xyz="0.18 -0.15 0" rpy="0 0 0.0" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="300" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>thruster_5_joint</joint_name>

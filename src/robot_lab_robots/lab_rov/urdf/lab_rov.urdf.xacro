    <origin xyz="-0.18 -0.15 0" rpy="0 0 0.0" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="300" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>thruster_7_joint</joint_name>
      <thrust_coefficient>0.0044</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.08</propeller_diameter>
      <min_thrust_cmd>-12</min_thrust_cmd>
      <max_thrust_cmd>12</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-hydrodynamics-system" name="ignition::gazebo::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <default_current>0.1 0.0 0.0</default_current>
      <xDotU>3</xDotU>
      <yDotV>5</yDotV>
      <zDotW>7</zDotW>
      <kDotP>0.04</kDotP>
      <mDotQ>0.08</mDotQ>
      <nDotR>0.08</nDotR>
      <xU>-8</xU>
      <yV>-12</yV>
      <zW>-15</zW>
      <kP>-0.2</kP>
      <mQ>-0.3</mQ>
      <nR>-0.3</nR>
      <xUabsU>-20</xUabsU>
      <yVabsV>-30</yVabsV>
      <zWabsW>-35</zWabsW>
      <kPabsP>-0.3</kPabsP>
      <mQabsQ>-0.5</mQabsQ>
      <nRabsR>-0.5</nRabsR>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/marine/odometry</odom_topic>
      <tf_topic>/marine/truth_pose</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/marine/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="lab_rov">
  <xacro:arg name="is_ignition" default="true" />
  <xacro:arg name="model_name" default="lab_rov" />
  <xacro:include filename="$(find robot_lab_robots)/description_common/urdf/oakd_camera.xacro" />
  <material name="dark_grey">
    <color rgba=".15 .18 .2 1" />
  </material>
  <material name="rov_yellow">
    <color rgba=".95 .7 .1 1" />
  </material>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -.025" rpy="0 0 0" />
      <mass value="18.4" />
      <inertia ixx=".159466667" iyy=".284586667" izz=".365546667" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual name="hull_visual">
      <geometry>
        <box size=".4 .28 .16" />
      </geometry>
      <material name="rov_yellow" />
    </visual>
    <collision name="hull_collision">
      <geometry>
        <box size=".4 .28 .16" />
      </geometry>
    </collision>
  </link>
  <xacro:oakd name="oakd" parent_link="base_link" model="pro" mesh_visual="false">
    <origin xyz=".21 0 .06" rpy="0 0 0" />
  </xacro:oakd>
  <gazebo reference="base_link">
    <sensor name="marine_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/marine/imu</topic>
      <gz_frame_id>base_link</gz_frame_id>
    </sensor>
  </gazebo>
  <link name="thruster_0_link">
    <inertial>
      <mass value=".01" />
      <inertia ixx=".000004" iyy=".000004" izz=".000004" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius=".04" length=".008" />
      </geometry>
      <material name="dark_grey" />
    </visual>
  </link>
  <joint name="thruster_0_joint" type="continuous">
    <parent link="base_link" />
    <child link="thruster_0_link" />
    <origin xyz="0.18 0.15 0" rpy="0 0 -0.7853981633974483" />
    <axis xyz="1 0 0" />
    <limit effort="2" velocity="300" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>thruster_0_joint</joint_name>
      <thrust_coefficient>0.0044</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.08</propeller_diameter>
      <min_thrust_cmd>-12</min_thrust_cmd>
      <max_thrust_cmd>12</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <link name="thruster_1_link">
    <inertial>
      <mass value=".01" />
      <inertia ixx=".000004" iyy=".000004" izz=".000004" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius=".04" length=".008" />
      </geometry>
      <material name="dark_grey" />
    </visual>
  </link>
  <joint name="thruster_1_joint" type="continuous">
    <parent link="base_link" />
    <child link="thruster_1_link" />
    <origin xyz="0.18 -0.15 0" rpy="0 0 0.7853981633974483" />
    <axis xyz="1 0 0" />
    <limit effort="2" velocity="300" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>thruster_1_joint</joint_name>
      <thrust_coefficient>0.0044</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.08</propeller_diameter>
      <min_thrust_cmd>-12</min_thrust_cmd>
      <max_thrust_cmd>12</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <link name="thruster_2_link">
    <inertial>
      <mass value=".01" />
      <inertia ixx=".000004" iyy=".000004" izz=".000004" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius=".04" length=".008" />

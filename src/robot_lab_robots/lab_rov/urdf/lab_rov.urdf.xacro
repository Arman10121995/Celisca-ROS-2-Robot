      <material name="dark_grey" />
    </visual>
  </link>
  <joint name="thruster_2_joint" type="continuous">
    <parent link="base_link" />
    <child link="thruster_2_link" />
    <origin xyz="-0.18 0.15 0" rpy="0 0 0.7853981633974483" />
    <axis xyz="1 0 0" />
    <limit effort="2" velocity="300" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>thruster_2_joint</joint_name>
      <thrust_coefficient>0.0044</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.08</propeller_diameter>
      <min_thrust_cmd>-12</min_thrust_cmd>
      <max_thrust_cmd>12</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <link name="thruster_3_link">
    <inertial>
      <mass value=".01" />
      <inertia ixx=".000004" iyy=".000004" izz=".000004" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57079632679 0" />
      <geometry>
        <cylinder radius=".04" length=".008" />
      </geometry>
      <material name="dark_grey" />
    </visual>
  </link>
  <joint name="thruster_3_joint" type="continuous">
    <parent link="base_link" />
    <child link="thruster_3_link" />
    <origin xyz="-0.18 -0.15 0" rpy="0 0 -0.7853981633974483" />
    <axis xyz="1 0 0" />
    <limit effort="2" velocity="300" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">
      <namespace>$(arg model_name)</namespace>
      <joint_name>thruster_3_joint</joint_name>
      <thrust_coefficient>0.0044</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.08</propeller_diameter>
      <min_thrust_cmd>-12</min_thrust_cmd>
      <max_thrust_cmd>12</max_thrust_cmd>
      <velocity_control>true</velocity_control>
    </plugin>
  </gazebo>
  <link name="thruster_4_link">
    <inertial>
      <mass value=".01" />
      <inertia ixx=".000004" iyy=".000004" izz=".000004" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius=".04" length=".008" />
      </geometry>
      <material name="dark_grey" />
    </visual>
  </link>
  <joint name="thruster_4_joint" type="continuous">
    <parent link="base_link" />
    <child link="thruster_4_link" />
    <origin xyz="0.18 0.15 0" rpy="0 0 0.0" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="300" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-thruster-system" name="ignition::gazebo::systems::Thruster">

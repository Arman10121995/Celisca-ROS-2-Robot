<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="oomwoo">

  <ros2_control name="RobotSystem" type="system">

    <xacro:if value="$(arg is_sim)">
      <xacro:if value="$(arg is_ignition)">
        <hardware>
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </hardware>
      </xacro:if>
      <xacro:unless value="$(arg is_ignition)">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
      </xacro:unless>
    </xacro:if>

    <!-- No real OOMWOO hardware interface exists yet. -->
    <xacro:unless value="$(arg is_sim)">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
    </xacro:unless>

    <xacro:macro name="wheel_interface" params="name">
      <joint name="${name}">
        <command_interface name="velocity">
          <param name="min">-14</param>
          <param name="max">14</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <xacro:if value="$(arg is_sim)">
          <state_interface name="effort"/>
        </xacro:if>
      </joint>
    </xacro:macro>
    <xacro:wheel_interface name="left_wheel_joint"/>
    <xacro:wheel_interface name="right_wheel_joint"/>

  </ros2_control>

</robot>

<?xml version="1.0"?>
<robot name="oomwoo" xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    OOMWOO-class robot vacuum (experimental lab model).

    The OOMWOO open-source vacuum (github.com/makers-pet/oomwoo) has no frozen
    hardware yet; its wiki names only "an affordable 2D LiDAR" and a Raspberry
    Pi CM4/CM5.  The dimensions below are lab-chosen values typical of a 2D
    LiDAR home robot vacuum, not OOMWOO's: 0.33 m round body, 0.10 m tall
    with the LiDAR turret, differential drive (wheel radius 0.035 m,
    separation 0.22 m), front and rear casters, a full-ring contact bumper,
    two downward cliff range sensors and an IMU.  Primitive geometry only.
  -->

  <xacro:arg name="is_ignition" default="true"/>
  <xacro:arg name="is_sim" default="true"/>

  <xacro:property name="body_radius" value="0.165"/>
  <xacro:property name="body_height" value="0.075"/>
  <xacro:property name="ground_clearance" value="0.012"/>
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width" value="0.022"/>
  <xacro:property name="wheel_separation" value="0.22"/>
  <!-- base_link sits at the wheel axle, wheel_radius above the floor -->
  <xacro:property name="body_z" value="${ground_clearance + body_height / 2 - wheel_radius}"/>
  <xacro:property name="body_top" value="${ground_clearance + body_height - wheel_radius}"/>

  <xacro:include filename="$(find robot_lab_robots)/oomwoo/urdf/oomwoo_gazebo.xacro" />
  <xacro:include filename="$(find robot_lab_robots)/oomwoo/urdf/oomwoo_ros2_control.xacro" />

  <material name="oomwoo_shell"><color rgba="0.92 0.92 0.90 1"/></material>
  <material name="oomwoo_dark"><color rgba="0.12 0.12 0.13 1"/></material>
  <material name="oomwoo_bumper"><color rgba="0.35 0.36 0.38 1"/></material>
  <material name="oomwoo_accent"><color rgba="0.10 0.55 0.85 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <mass value="3.2"/>
      <inertia ixx="0.0233" ixy="0" ixz="0" iyy="0.0233" iyz="0" izz="0.0436"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${body_radius - 0.006}" length="${body_height}"/></geometry>
      <material name="oomwoo_shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
      <geometry><cylinder radius="${body_radius - 0.006}" length="${body_height}"/></geometry>
    </collision>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Bumper ring: slightly wider than the shell so it touches first. -->
  <link name="bumper_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="2e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${body_radius}" length="0.04"/></geometry>
      <material name="oomwoo_bumper"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${body_radius}" length="0.04"/></geometry>
    </collision>
  </link>

  <joint name="bumper_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bumper_link"/>
    <origin xyz="0 0 ${body_z - 0.008}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="wheel_${side}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="4.2e-5" ixy="0" ixz="0" iyy="7.4e-5" iyz="0" izz="4.2e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="oomwoo_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${wheel_separation / 2}"/>
  <xacro:drive_wheel side="right" y="${-wheel_separation / 2}"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.02"/>
        <inertia ixx="2e-6" ixy="0" ixz="0" iyy="2e-6" iyz="0" izz="2e-6"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.012"/></geometry>
        <material name="oomwoo_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="0.012"/></geometry>
      </collision>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${0.012 - wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="front" x="0.12"/>
  <xacro:caster name="rear" x="-0.12"/>

  <!-- Main brush (visual only) across the underside, behind the wheels' axis. -->
  <link name="main_brush_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.012" length="0.17"/></geometry>
      <material name="oomwoo_accent"/>
    </visual>
  </link>
  <joint name="main_brush_joint" type="fixed">
    <parent link="base_link"/>
    <child link="main_brush_link"/>
    <origin xyz="-0.04 0 ${ground_clearance + 0.012 - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR turret on top. -->
  <link name="lidar_turret_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="0.022"/></geometry>
      <material name="oomwoo_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="0.022"/></geometry>
    </collision>
  </link>
  <joint name="lidar_turret_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_turret_link"/>
    <origin xyz="0.04 0 ${body_top + 0.011}" rpy="0 0 0"/>
  </joint>

  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.04 0 ${body_top + 0.016}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Cliff sensors: downward range sensors behind the front edge. -->
  <xacro:macro name="cliff" params="side y">
    <link name="cliff_${side}_link"/>
    <joint name="cliff_${side}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="cliff_${side}_link"/>
      <origin xyz="0.135 ${y} ${ground_clearance - 0.004 - wheel_radius}" rpy="0 1.5708 0"/>
    </joint>
  </xacro:macro>
  <xacro:cliff side="front_left" y="0.07"/>
  <xacro:cliff side="front_right" y="-0.07"/>

</robot>

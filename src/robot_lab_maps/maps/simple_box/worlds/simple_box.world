<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="simple_box">
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -1.0</direction>
    </light>

    <model name="physics_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>100 100 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>100 100 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="simple_box_map">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://robot_lab_maps/maps/simple_box/meshes/simple_box.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.5 1.0</ambient>
            <diffuse>0.1 0.1 0.4 1.0</diffuse>
            <specular>0.05 0.05 0.1 1.0</specular>
          </material>
        </visual>

        <visual name="visual_backfaces">
          <geometry>
            <mesh>
              <uri>package://robot_lab_maps/maps/simple_box/meshes/simple_box.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.5 1.0</ambient>
            <diffuse>0.1 0.1 0.4 1.0</diffuse>
            <specular>0.05 0.05 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>




    <model name="Sofa">
      <include>
        <uri>model://aws_robomaker_residential_Sofa_01</uri>
      </include>
      <pose>-3.625 -3.625 0 0 0 1.57</pose>
    </model>

    <model name="AC">
      <include>
        <uri>model://aws_robomaker_residential_AirconditionerA_01</uri>
      </include>
      <pose>-3 -4.8 3 0 0 1.57</pose>
    </model>

    <model name="Vase">
      <include>
        <uri>model://aws_robomaker_residential_Vase_01</uri>
      </include>
      <pose>-3.25 -3 1 0 0 1.57</pose>
    </model>

    <model name="Table">
      <include>
        <uri>model://aws_robomaker_residential_CoffeeTable_01</uri>
      </include>
      <pose>-3.25 -3 0 0 0 1.57</pose>
    </model>

  </world>
</sdf>

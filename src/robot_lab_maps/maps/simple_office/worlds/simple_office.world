<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="simple_office">
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.3 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple office setup using residential models from gazebo library -->
    <model name="desk">
      <include>
        <uri>model://aws_robomaker_residential_DeskPortraitA_01</uri>
      </include>
      <pose>1.5 0 0 0 0 0</pose>
    </model>
    <model name="chair">
      <include>
        <uri>model://aws_robomaker_residential_ChairA_01</uri>
      </include>
      <pose>1.5 0.8 0 0 0 -1.0</pose>
    </model>
    <model name="board">
      <include>
        <uri>model://aws_robomaker_residential_Board_01</uri>
      </include>
      <pose>-1 0 0 0 0 0</pose>
    </model>
    <model name="table">
      <include>
        <uri>model://aws_robomaker_residential_CoffeeTable_01</uri>
      </include>
      <pose>0 -1.5 0 0 0 1.57</pose>
    </model>
  </world>
</sdf>

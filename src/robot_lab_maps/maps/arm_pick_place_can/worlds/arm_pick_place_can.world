<?xml version="1.0" ?>
<!-- arm_pick_place_lab with a cylinder instead of the cube (ROADMAP R5.7):
     pickup_can is a loose 50 mm x 90 mm, 60 g upright cylinder.
     Fixed-arm pick-and-place scene (ROADMAP R5.7). A fixed-base arm stands at
     the origin; pickup_table and place_table (0.3 m cubes, tops at 0.30 m) are
     0.56 m away at y = -0.25 and +0.25; pickup_cube is a loose 40 mm, 50 g
     box on pickup_table. The tables are static; the cube is the only dynamic
     model, so importers that build free bodies (MuJoCo, PyBullet:
     sdf_world.extract_dynamic_bodies) keep it loose. Lab fixture, not a
     calibrated workcell. -->
<sdf version="1.7">
  <world name="arm_pick_place_can">
    <physics type="ode">
      <max_step_size>0.002</max_step_size>
    </physics>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.0 6.0 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.0 6.0 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.5 1</ambient><diffuse>0.55 0.55 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pickup_table">
      <static>true</static>
      <pose>0.5 -0.25 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="place_table">
      <static>true</static>
      <pose>0.5 0.25 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.45 0.35 0.25 1</ambient><diffuse>0.45 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pickup_can">
      <static>false</static>
      <pose>0.5 -0.25 0.345 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.06</mass>
          <inertia><ixx>4.988e-05</ixx><iyy>4.988e-05</iyy><izz>1.875e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.09</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.2 0.45 0.85 1</ambient><diffuse>0.2 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

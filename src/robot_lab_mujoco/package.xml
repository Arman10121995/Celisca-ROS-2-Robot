<?xml version="1.0"?>
<package format="3">
  <name>robot_lab_mujoco</name>
  <version>0.1.0</version>
  <description>MuJoCo simulator adapter for Robot Lab simulations.</description>
  <maintainer email="robot@example.com">Robot Lab</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>launch_ros</depend>
  <depend>robot_lab_description</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>robot_lab_utils</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>

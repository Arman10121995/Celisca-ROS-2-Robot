            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <topic>/scan</topic><gz_frame_id>base_scan</gz_frame_id></sensor>
    </gazebo><gazebo reference="scan_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo><gazebo reference="imu_link"><sensor name="tb3_imu" type="imu">
